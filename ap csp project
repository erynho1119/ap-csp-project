def typeOfPet():
    adopt = []
    pet = input("What type of pet do you want (dog,cat, or rabbit)?: ")
    adopt.append(pet)
    trait = input("What trait do you want your pet to have? (playful, smart, or affectionate): ")
    adopt.append(trait)
    price = input("What is your budget for the price of your pet? (min $20 (put dollar sign before number)): ")
    adopt.append(price)
    return adopt

